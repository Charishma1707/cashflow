              "raw": "{\n  \"customer\": {\n    \"name\": \"FinTech Ventures\",\n    \"email\": \"billing@fintechventures.io\",\n    \"address\": \"450 Mission St, San Francisco, CA\"\n  },\n  \"dueDate\": \"2026-11-01\",\n  \"items\": [\n    {\n      \"description\": \"API Architecture Consultation\",\n      \"quantity\": 1,\n      \"unitPrice\": 1800\n    },\n    {\n      \"description\": \"Figma Design System Sprint\",\n      \"quantity\": 1,\n      \"unitPrice\": 2400\n    }\n  ],\n  \"taxRate\": 0,\n  \"status\": \"SENT\",\n  \"notes\": \"Net 14 payment terms. PayPal Sandbox supported.\"\n}"
